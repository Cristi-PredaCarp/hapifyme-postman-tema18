							"});\r",
							"\r",
							"pm.test(\"Email confirmat cu succes\", function () {\r",
							"    pm.expect(pm.response.json().status).to.eql(\"success\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
