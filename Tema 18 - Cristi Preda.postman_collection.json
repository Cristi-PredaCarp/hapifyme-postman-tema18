		{
			"name": "Login:",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const loginResponse = pm.response.json();\r",
							"\r",
							"pm.test(\"Login - status 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Login reusit si token primit\", function () {\r",
							"    pm.expect(loginResponse.status).to.eql(\"success\");\r",
							"    pm.expect(loginResponse.token).to.be.a(\"string\").and.not.empty;\r",
							"    pm.expect(loginResponse.user.id).to.exist;\r",
							"});\r",
							"\r",
							"pm.test(\"Emailul corespunde contului creat\", function () {\r",
							"    pm.expect(loginResponse.user.email)\r",
							"        .to.eql(pm.environment.get(\"email\"));\r",
							"});\r",
							"\r",
							"if (pm.response.code === 200 &&\r",
							"    loginResponse.status === \"success\" &&\r",
							"    loginResponse.token &&\r",
							"    loginResponse.user &&\r",
							"    loginResponse.user.id) {\r",
							"\r",
							"    pm.environment.set(\"token\", loginResponse.token);\r",
							"    pm.environment.set(\"user_id\", loginResponse.user.id);\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"username\": \"{{username}}\",\r\n  \"password\": \"{{password}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/user/login.php",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"user",
						"login.php"
					]
				}
			},
			"response": []
		},
