	"item": [
		{
			"name": "Register",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const uniqueId = Date.now() + \"_\" +\r",
							"    Math.random().toString(36).slice(2, 8);\r",
							"\r",
							"pm.environment.set(\"email\", `qa_${uniqueId}@example.com`);\r",
							"pm.environment.set(\"password\", `Qa!${uniqueId}Aa9`);\r",
							"pm.environment.set(\"username\", `qa_${uniqueId}`);\r",
							"pm.environment.set(\"firstName\", `Test${Date.now()}`);\r",
							"pm.environment.set(\"lastName\", `User${Date.now()}`);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const registerResponse = pm.response.json();\r",
							"\r",
							"pm.test(\"Register - status 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"Inregistrare reusita si date primite\", function () {\r",
							"    pm.expect(registerResponse.status).to.eql(\"success\");\r",
							"    pm.expect(registerResponse.api_key).to.be.a(\"string\").and.not.empty;\r",
							"    pm.expect(registerResponse.confirmation_token)\r",
							"        .to.be.a(\"string\").and.not.empty;\r",
							"    pm.expect(registerResponse.username).to.be.a(\"string\").and.not.empty;\r",
							"    pm.expect(registerResponse.user_id).to.exist;\r",
							"});\r",
							"\r",
							"if (pm.response.code === 201 &&\r",
							"    registerResponse.status === \"success\") {\r",
							"\r",
							"    pm.environment.set(\"api_key\", registerResponse.api_key);\r",
							"    pm.environment.set(\"confirmation_token\",\r",
							"        registerResponse.confirmation_token);\r",
							"    pm.environment.set(\"username\", registerResponse.username);\r",
							"    pm.environment.set(\"user_id\", registerResponse.user_id);\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"{{password}}\",\r\n  \"first_name\": \"{{firstName}}\",\r\n  \"last_name\": \"{{lastName}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/user/register.php",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"user",
						"register.php"
					]
				}
			},
			"response": []
		},
		{
			"name": "Confirm Email",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Confirmare - status 200\", function () {\r",
